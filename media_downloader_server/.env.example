SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Shared secret the RN app must send as X-API-Key on every request.
API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# https://developer.spotify.com/dashboard -> create an app for these
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Fixes YouTube's "Sign in to confirm you're not a bot" on server IPs.
# On a headless host (Render etc.) there's no browser, so generate a
# cookies.txt LOCALLY (on a machine with Chrome/Firefox logged into
# YouTube) with:
#   yt-dlp --cookies-from-browser chrome --cookies youtube_cookies.txt https://youtube.com
# Then upload it as a Render "Secret File" (dashboard -> Environment ->
# Secret Files) mounted at, say, /etc/secrets/youtube_cookies.txt, and
# set this to that mount path. Never commit the cookies file to git.
YTDLP_COOKIES_FILE=

# Local dev only -- pulls cookies from a browser installed on THIS
# machine. Does nothing on a deployed server (no browser there).
YTDLP_COOKIES_FROM_BROWSER=
